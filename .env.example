# Postgres
POSTGRES_DB=signage
POSTGRES_USER=signage
POSTGRES_PASSWORD=signage_dev

# PostgREST authenticator role password (must match what 01_extensions.sql sets)
AUTHENTICATOR_PASSWORD=auth_dev

# JWT secret used by both the `login()` SQL function and PostgREST.
# MUST be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
